# ==============================================================================
# PORTFOLIO EMAIL CONFIGURATION
# ==============================================================================

# Destination email where inquiries from the contact form should be sent:
ADMIN_EMAIL=prpatel0949@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: SendGrid Free Tier (Recommended — 100 emails/day free forever)
# ------------------------------------------------------------------------------
# 1. Sign up for a free SendGrid account: https://signup.sendgrid.com/
# 2. Go to Settings > Sender Authentication > Single Sender Verification:
#    Verify the email you want to send from (prpatel0949@gmail.com).
# 3. Go to Settings > API Keys > Create API Key (with "Full Access" or "Mail Send").
# 4. Fill in these two variables:

SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=prpatel0949@gmail.com

# ------------------------------------------------------------------------------
# OPTION 2: Gmail SMTP (Alternative)
# ------------------------------------------------------------------------------
# If you prefer using Gmail directly with an App Password instead of SendGrid:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-google-app-password

# ------------------------------------------------------------------------------
# GOOGLE SHEETS INQUIRY LOGGER (Optional CRM)
# ------------------------------------------------------------------------------
# Webhook URL from your Google Sheet Apps Script deployment:
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec

